<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Compact toolbar row: Language, model selector, clipboard, select all, privacy, history, and toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/ime_language_switch"
            android:layout_width="wrap_content"
            android:minWidth="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/ime_switch_language"/>

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/ime_model_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_model"
                android:scaleType="centerInside"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/ime_model_selector"/>

            <Spinner
                android:id="@+id/ime_model_spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:spinnerMode="dropdown"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ime_model_selector"/>
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/ime_paste_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_paste"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_paste_button"/>

        <ImageView
            android:id="@+id/ime_copy_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_copy"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_copy_button"/>

        <ImageView
            android:id="@+id/ime_clear_clipboard_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_clear_clipboard"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_clear_clipboard_button"/>

        <ImageView
            android:id="@+id/ime_cut_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_cut"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_cut_button"/>

        <ImageView
            android:id="@+id/ime_select_all"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_select_all"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_select_all"/>

        <ImageView
            android:id="@+id/ime_privacy_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_incognito"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_privacy_mode"/>

        <ImageView
            android:id="@+id/ime_history_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_history"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_history_button"/>

        <ImageView
            android:id="@+id/ime_expand_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_expand_more"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_expand_keys"/>
    </LinearLayout>

    <!-- WPM of the last paste, shown directly below the toolbar when active -->
    <TextView
        android:id="@+id/ime_last_wpm_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorPrimary"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/ime_stats_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"/>

    <!-- History View: shown instead of record area when history button is tapped -->
    <LinearLayout
        android:id="@+id/ime_history_container"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- History header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ime_history_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ime_history_retention_notice"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ime_history_clear_all"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_delete"
                android:scaleType="centerInside"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/ime_history_clear_all"/>

            <ImageView
                android:id="@+id/ime_history_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/ime_history_close"/>
        </LinearLayout>

        <!-- Scrollable list of recent items -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/ime_history_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/ime_history_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <TextView
                android:id="@+id/ime_history_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/ime_history_empty"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Record button: full-width rounded rectangle action button, slim and easy to tap -->
    <FrameLayout
        android:id="@+id/ime_record_container"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/ime_record_circle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ime_record"/>

        <!-- Centered content: icon (or spinner) + status text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical">

                <dev.notune.transcribe.MicLevelView
                    android:id="@+id/ime_mic_level"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"/>

                <ImageView
                    android:id="@+id/ime_mic_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mic"
                    android:layout_gravity="center"
                    android:contentDescription="@string/section_ime"/>

                <ProgressBar
                    android:id="@+id/ime_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/colorPrimary"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/ime_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Tap to speak"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/ime_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Tap to Record"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Collapsible bottom key row -->
    <LinearLayout
        android:id="@+id/ime_bottom_key_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ime_space"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:src="@drawable/ic_space"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Space"/>

        <ImageView
            android:id="@+id/ime_enter"
            android:layout_width="56dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_enter"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Enter"/>

        <ImageView
            android:id="@+id/ime_backspace"
            android:layout_width="56dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Backspace"/>
    </LinearLayout>

</LinearLayout>
