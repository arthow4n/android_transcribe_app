<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Compact toolbar row: Language, model selector, clipboard, select all, privacy, history, and toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/ime_language_switch"
            android:layout_width="wrap_content"
            android:minWidth="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/ime_switch_language"/>

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/ime_model_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_model"
                android:scaleType="centerInside"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/ime_model_selector"/>

            <Spinner
                android:id="@+id/ime_model_spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:spinnerMode="dropdown"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ime_model_selector"/>
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/ime_paste_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_paste"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_paste_button"/>

        <ImageView
            android:id="@+id/ime_copy_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_copy"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_copy_button"/>

        <ImageView
            android:id="@+id/ime_clear_clipboard_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_clear_clipboard"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_clear_clipboard_button"/>

        <ImageView
            android:id="@+id/ime_cut_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_cut"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_cut_button"/>

        <ImageView
            android:id="@+id/ime_select_all"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_select_all"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_select_all"/>

        <ImageView
            android:id="@+id/ime_privacy_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_incognito"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_privacy_mode"/>

        <ImageView
            android:id="@+id/ime_history_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_history"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_history_button"/>

        <ImageView
            android:id="@+id/ime_expand_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_expand_more"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ime_expand_keys"/>
    </LinearLayout>

    <!-- WPM of the last paste, shown directly below the toolbar when active -->
    <TextView
        android:id="@+id/ime_last_wpm_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorPrimary"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/ime_stats_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"/>

    <!-- History View: shown instead of record area when history button is tapped -->
    <LinearLayout
        android:id="@+id/ime_history_container"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- History header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ime_history_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ime_history_retention_notice"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ime_history_clear_all"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_delete"
                android:scaleType="centerInside"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/ime_history_clear_all"/>

            <ImageView
                android:id="@+id/ime_history_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/ime_history_close"/>
        </LinearLayout>

        <!-- Scrollable list of recent items -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/ime_history_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/ime_history_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <TextView
                android:id="@+id/ime_history_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/ime_history_empty"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Swedish QWERTY Typing Panel (collapsible) -->
    <LinearLayout
        android:id="@+id/ime_qwerty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <!-- Row 1: Quotes & Programming Brackets (11 keys) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView android:id="@+id/ime_key_backtick" style="@style/ImeQwertyKey" android:text="&#x60;" />
            <TextView android:id="@+id/ime_key_quote_single" style="@style/ImeQwertyKey" android:text="&apos;" />
            <TextView android:id="@+id/ime_key_quote_double" style="@style/ImeQwertyKey" android:text="&quot;" />
            <TextView android:id="@+id/ime_key_brace_open" style="@style/ImeQwertyKey" android:text="{" />
            <TextView android:id="@+id/ime_key_brace_close" style="@style/ImeQwertyKey" android:text="}" />
            <TextView android:id="@+id/ime_key_bracket_open" style="@style/ImeQwertyKey" android:text="[" />
            <TextView android:id="@+id/ime_key_bracket_close" style="@style/ImeQwertyKey" android:text="]" />
            <TextView android:id="@+id/ime_key_underscore" style="@style/ImeQwertyKey" android:text="_" />
            <TextView android:id="@+id/ime_key_minus" style="@style/ImeQwertyKey" android:text="-" />
            <TextView android:id="@+id/ime_key_equal" style="@style/ImeQwertyKey" android:text="=" />
            <TextView android:id="@+id/ime_key_question" style="@style/ImeQwertyKey" android:text="?" />
        </LinearLayout>

        <!-- Row 2: US Symbols (11 keys) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="2dp">
            <TextView android:id="@+id/ime_key_exclamation" style="@style/ImeQwertyKey" android:text="!" />
            <TextView android:id="@+id/ime_key_at" style="@style/ImeQwertyKey" android:text="@" />
            <TextView android:id="@+id/ime_key_hash" style="@style/ImeQwertyKey" android:text="#" />
            <TextView android:id="@+id/ime_key_dollar" style="@style/ImeQwertyKey" android:text="$" />
            <TextView android:id="@+id/ime_key_percent" style="@style/ImeQwertyKey" android:text="%" />
            <TextView android:id="@+id/ime_key_caret" style="@style/ImeQwertyKey" android:text="^" />
            <TextView android:id="@+id/ime_key_ampersand" style="@style/ImeQwertyKey" android:text="&amp;" />
            <TextView android:id="@+id/ime_key_asterisk" style="@style/ImeQwertyKey" android:text="*" />
            <TextView android:id="@+id/ime_key_paren_open" style="@style/ImeQwertyKey" android:text="(" />
            <TextView android:id="@+id/ime_key_paren_close" style="@style/ImeQwertyKey" android:text=")" />
            <TextView android:id="@+id/ime_key_slash" style="@style/ImeQwertyKey" android:text="/" />
        </LinearLayout>

        <!-- Row 3: Numbers (1-0, 10 keys) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="2dp">
            <TextView android:id="@+id/ime_key_1" style="@style/ImeQwertyKey" android:text="1" />
            <TextView android:id="@+id/ime_key_2" style="@style/ImeQwertyKey" android:text="2" />
            <TextView android:id="@+id/ime_key_3" style="@style/ImeQwertyKey" android:text="3" />
            <TextView android:id="@+id/ime_key_4" style="@style/ImeQwertyKey" android:text="4" />
            <TextView android:id="@+id/ime_key_5" style="@style/ImeQwertyKey" android:text="5" />
            <TextView android:id="@+id/ime_key_6" style="@style/ImeQwertyKey" android:text="6" />
            <TextView android:id="@+id/ime_key_7" style="@style/ImeQwertyKey" android:text="7" />
            <TextView android:id="@+id/ime_key_8" style="@style/ImeQwertyKey" android:text="8" />
            <TextView android:id="@+id/ime_key_9" style="@style/ImeQwertyKey" android:text="9" />
            <TextView android:id="@+id/ime_key_0" style="@style/ImeQwertyKey" android:text="0" />
        </LinearLayout>

        <!-- Row 4: q w e r t y u i o p å (11 keys) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="2dp">
            <TextView android:id="@+id/ime_key_q" style="@style/ImeQwertyKey" android:text="q" />
            <TextView android:id="@+id/ime_key_w" style="@style/ImeQwertyKey" android:text="w" />
            <TextView android:id="@+id/ime_key_e" style="@style/ImeQwertyKey" android:text="e" />
            <TextView android:id="@+id/ime_key_r" style="@style/ImeQwertyKey" android:text="r" />
            <TextView android:id="@+id/ime_key_t" style="@style/ImeQwertyKey" android:text="t" />
            <TextView android:id="@+id/ime_key_y" style="@style/ImeQwertyKey" android:text="y" />
            <TextView android:id="@+id/ime_key_u" style="@style/ImeQwertyKey" android:text="u" />
            <TextView android:id="@+id/ime_key_i" style="@style/ImeQwertyKey" android:text="i" />
            <TextView android:id="@+id/ime_key_o" style="@style/ImeQwertyKey" android:text="o" />
            <TextView android:id="@+id/ime_key_p" style="@style/ImeQwertyKey" android:text="p" />
            <TextView android:id="@+id/ime_key_aring" style="@style/ImeQwertyKey" android:text="å" />
        </LinearLayout>

        <!-- Row 5: a s d f g h j k l ö ä (11 keys) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="2dp">
            <TextView android:id="@+id/ime_key_a" style="@style/ImeQwertyKey" android:text="a" />
            <TextView android:id="@+id/ime_key_s" style="@style/ImeQwertyKey" android:text="s" />
            <TextView android:id="@+id/ime_key_d" style="@style/ImeQwertyKey" android:text="d" />
            <TextView android:id="@+id/ime_key_f" style="@style/ImeQwertyKey" android:text="f" />
            <TextView android:id="@+id/ime_key_g" style="@style/ImeQwertyKey" android:text="g" />
            <TextView android:id="@+id/ime_key_h" style="@style/ImeQwertyKey" android:text="h" />
            <TextView android:id="@+id/ime_key_j" style="@style/ImeQwertyKey" android:text="j" />
            <TextView android:id="@+id/ime_key_k" style="@style/ImeQwertyKey" android:text="k" />
            <TextView android:id="@+id/ime_key_l" style="@style/ImeQwertyKey" android:text="l" />
            <TextView android:id="@+id/ime_key_ouml" style="@style/ImeQwertyKey" android:text="ö" />
            <TextView android:id="@+id/ime_key_auml" style="@style/ImeQwertyKey" android:text="ä" />
        </LinearLayout>

        <!-- Row 6: Shift (1.5) | z x c v b n m (7 keys) | , (1.25) | . (1.25) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="2dp">
            <ImageView
                android:id="@+id/ime_key_shift"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shift"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="@drawable/bg_ime_key"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="1.5dp"
                android:contentDescription="Shift" />
            <TextView android:id="@+id/ime_key_z" style="@style/ImeQwertyKey" android:text="z" />
            <TextView android:id="@+id/ime_key_x" style="@style/ImeQwertyKey" android:text="x" />
            <TextView android:id="@+id/ime_key_c" style="@style/ImeQwertyKey" android:text="c" />
            <TextView android:id="@+id/ime_key_v" style="@style/ImeQwertyKey" android:text="v" />
            <TextView android:id="@+id/ime_key_b" style="@style/ImeQwertyKey" android:text="b" />
            <TextView android:id="@+id/ime_key_n" style="@style/ImeQwertyKey" android:text="n" />
            <TextView android:id="@+id/ime_key_m" style="@style/ImeQwertyKey" android:text="m" />
            <TextView
                android:id="@+id/ime_key_comma"
                style="@style/ImeQwertyKey"
                android:layout_weight="1.25"
                android:text="," />
            <TextView
                android:id="@+id/ime_key_dot"
                style="@style/ImeQwertyKey"
                android:layout_weight="1.25"
                android:text="." />
        </LinearLayout>
    </LinearLayout>

    <!-- Unified Action Row: Push-to-speak (3 icons wide), Space (flex), Backspace, Delete Word, Enter -->
    <LinearLayout
        android:id="@+id/ime_action_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">

        <!-- Push to speak button: 3 icon button spaces (~132dp) on the left -->
        <FrameLayout
            android:id="@+id/ime_record_container"
            android:layout_width="132dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/ime_record_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ime_record"/>

            <!-- Centered icon (mic / waveform / spinner) without text -->
            <!-- Sound wave ripples expand to fill the full button width -->
            <dev.notune.transcribe.MicLevelView
                android:id="@+id/ime_mic_level"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ImageView
                android:id="@+id/ime_mic_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_mic"
                android:layout_gravity="center"
                android:contentDescription="@string/section_ime"/>

            <ProgressBar
                android:id="@+id/ime_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="?attr/colorPrimary"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Space button: flexible in the middle -->
        <ImageView
            android:id="@+id/ime_space"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:src="@drawable/ic_space"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="Space"/>

        <!-- Delete character -->
        <ImageView
            android:id="@+id/ime_backspace"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="Backspace"/>

        <!-- Delete word -->
        <ImageView
            android:id="@+id/ime_delete_word"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_delete_word"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/ime_delete_word"/>

        <!-- Enter button at right-most position -->
        <ImageView
            android:id="@+id/ime_enter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_enter"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Enter"/>
    </LinearLayout>

</LinearLayout>
