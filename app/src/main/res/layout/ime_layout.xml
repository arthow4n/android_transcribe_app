<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="12dp">

    <!-- Status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/ime_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap to speak"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:paddingStart="4dp"/>

        <ProgressBar
            android:id="@+id/ime_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- The active model is also a quick selector for installed models. -->
    <Spinner
        android:id="@+id/ime_model_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:backgroundTint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/ime_model_selector"/>

    <TextView
        android:id="@+id/ime_stats_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone"/>

    <!-- Record area: pulsing mic-level glow behind a circular record button -->
    <FrameLayout
        android:id="@+id/ime_record_container"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:clickable="true"
        android:focusable="true">

        <dev.notune.transcribe.MicLevelView
            android:id="@+id/ime_mic_level"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"/>

        <View
            android:id="@+id/ime_record_circle"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ime_record"/>

        <ImageView
            android:id="@+id/ime_mic_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_mic"
            android:layout_gravity="center"
            android:contentDescription="@string/section_ime"/>

        <TextView
            android:id="@+id/ime_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to Record"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="12dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceBodySmall"/>
    </FrameLayout>

    <!-- Fast language selection for multilingual dictation. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/ime_language_group"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        app:selectionRequired="false"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_language_sv"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/ime_language_sv" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_language_zh_tw"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/ime_language_zh_tw" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_language_en"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/ime_language_en" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Bottom key row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/ime_switch_keyboard"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_keyboard_switch"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Switch keyboard"/>

        <ImageView
            android:id="@+id/ime_space"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:src="@drawable/ic_space"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Space"/>

        <ImageView
            android:id="@+id/ime_enter"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_enter"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Enter"/>

        <ImageView
            android:id="@+id/ime_backspace"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Backspace"/>

        <ImageView
            android:id="@+id/ime_select_all"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_select_all"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/ime_select_all"/>
    </LinearLayout>

</LinearLayout>
